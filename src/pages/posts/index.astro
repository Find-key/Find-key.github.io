---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostList from '../../components/PostList.astro';
import { SITE } from '../../consts';
import { isVisible, type Post } from '../../utils/posts';

// 归档按时间倒序（首页是按分类，两者是互补的两个入口）
const posts = (await getCollection('blog', isVisible)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 年份要按站点时区算，否则年初的文章在 UTC 构建机上会被归到上一年
const yearOf = (date: Date) =>
	new Intl.DateTimeFormat('en-CA', { year: 'numeric', timeZone: SITE.timeZone }).format(date);

const byYear = new Map<string, Post[]>();
for (const post of posts) {
	const year = yearOf(post.data.pubDate);
	byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
const years = [...byYear.entries()];
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<BaseHead title={`归档 · ${SITE.title}`} description={`${SITE.title} 的文章归档`} />
	</head>
	<body>
		<Header />
		<main class="container page">
			<h1>归档</h1>
			{posts.length > 0 && <p class="sub">共 {posts.length} 篇，按年份倒序</p>}

			{
				years.map(([year, items]) => (
					<section class="year">
						<header class="year-head">
							<h2>{year}</h2>
							<span class="count">{items.length} 篇</span>
						</header>
						<PostList posts={items} compact />
					</section>
				))
			}

			{posts.length === 0 && <p class="empty">还没有文章。</p>}
		</main>
		<Footer />
	</body>
</html>

<style>
	.page {
		padding-top: 3.5rem;
	}
	h1 {
		margin: 0 0 0.2em;
		font-size: 1.9rem;
		font-weight: 600;
		letter-spacing: -0.005em;
	}
	.sub {
		margin: 0 0 2.5rem;
		color: var(--muted);
		font-size: 0.84rem;
	}
	.year + .year {
		margin-top: 2.75rem;
	}
	.year-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--line-strong);
	}
	.year-head h2 {
		margin: 0;
		font-size: 1.15rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}
	.count {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.68rem;
	}
	.empty {
		color: var(--muted);
	}
</style>
