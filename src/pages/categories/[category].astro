---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostList from '../../components/PostList.astro';
import { CATEGORIES, SITE } from '../../consts';
import { isVisible, postsOfCategory } from '../../utils/posts';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
	const posts = await getCollection('blog', isVisible);
	// 只给有文章的分类生成页面，避免线上出现空页面
	return CATEGORIES.filter((category) => postsOfCategory(posts, category.slug).length > 0).map(
		(category) => ({
			params: { category: category.slug },
			props: { category, posts: postsOfCategory(posts, category.slug) },
		}),
	);
}

const { category, posts } = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<BaseHead
			title={`${category.name} · ${SITE.title}`}
			description={category.description}
		/>
	</head>
	<body>
		<Header />
		<main class="container page">
			<nav class="crumb" aria-label="位置">
				<a href={`${withBase('/')}#${category.slug}`}>首页</a>
				<span class="sep">/</span>
				<span>{category.name}</span>
			</nav>
			<h1>{category.name}</h1>
			<p class="sub">{category.description}</p>

			{posts.length > 0 ? <PostList posts={posts} /> : <p class="empty">这个分类还没有文章。</p>}

			<p class="back">
				<a href={`${withBase('/')}#${category.slug}`}>← 返回首页</a>
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page {
		padding-top: 3.5rem;
	}
	.crumb {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		color: var(--muted);
		font-size: 0.78rem;
		margin-bottom: 0.9rem;
	}
	.crumb a {
		color: var(--muted);
	}
	.crumb a:hover {
		color: var(--text);
		text-decoration: none;
	}
	.crumb .sep {
		color: var(--line-strong);
	}
	h1 {
		margin: 0 0 0.25em;
		font-size: 1.9rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	.sub {
		margin: 0 0 2rem;
		color: var(--muted);
		font-size: 0.86rem;
	}
	.back {
		margin-top: 2.5rem;
		font-size: 0.84rem;
	}
	.empty {
		color: var(--muted);
	}
</style>
