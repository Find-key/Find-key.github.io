---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE } from '../../consts';
import { allPosts, groupByCategory } from '../../utils/posts';
import { categoryUrl, postUrl } from '../../utils/url';

const posts = await allPosts();
const groups = groupByCategory(posts);
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<BaseHead title={`分类 · ${SITE.title}`} description={`${SITE.title} 的文章分类`} />
	</head>
	<body>
		<Header />
		<main class="container page">
			<h1>分类</h1>
			<p class="sub">文章按主题归类，而不是按时间堆在一条流里</p>

			<ul class="cats">
				{
					groups.map(({ category, posts: items }) => (
						<li>
							<div class="head">
								<h2>
									<a href={categoryUrl(category.slug)}>{category.name}</a>
								</h2>
								<span class="count">{items.length} 篇</span>
							</div>
							<p class="desc">{category.description}</p>
							<ul class="recent">
								{items.slice(0, 3).map((post) => (
									<li>
										<a href={postUrl(post.id)}>{post.data.title}</a>
									</li>
								))}
							</ul>
						</li>
					))
				}
			</ul>

			{groups.length === 0 && <p class="empty">还没有分类下的文章。</p>}
		</main>
		<Footer />
	</body>
</html>

<style>
	.page {
		padding-top: 3.5rem;
	}
	h1 {
		margin: 0 0 0.2em;
		font-size: 1.65rem;
		font-weight: 650;
		letter-spacing: -0.01em;
	}
	.sub {
		margin: 0 0 2.5rem;
		color: var(--muted);
		font-size: 0.84rem;
	}
	.cats {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.cats > li {
		padding: 1.25rem 1.35rem 1.4rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
	}
	.head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}
	h2 {
		margin: 0;
		font-size: 1rem;
		font-weight: 600;
	}
	h2 a {
		color: var(--text);
	}
	h2 a:hover {
		color: var(--accent);
		text-decoration: none;
	}
	.count {
		color: var(--muted);
		font-size: 0.74rem;
		font-variant-numeric: tabular-nums;
	}
	.desc {
		margin: 0.4rem 0 0.8rem;
		color: var(--muted);
		font-size: 0.82rem;
		line-height: 1.65;
	}
	.recent {
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 0.84rem;
	}
	.recent li {
		padding: 0.22rem 0;
	}
	.recent a {
		color: var(--text);
	}
	.recent a:hover {
		color: var(--accent);
		text-decoration: none;
	}
	.empty {
		color: var(--muted);
	}
	@media (max-width: 720px) {
		.cats {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
