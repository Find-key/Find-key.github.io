---
import { allPosts } from '../../utils/posts';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE } from '../../consts';
import { tagUrl } from '../../utils/url';

const posts = await allPosts();

const tagMap = new Map<string, number>();
for (const post of posts) {
	for (const tag of post.data.tags) {
		tagMap.set(tag, (tagMap.get(tag) ?? 0) + 1);
	}
}
const tags = [...tagMap.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<BaseHead title={`标签 · ${SITE.title}`} description={`${SITE.title} 的全部标签`} />
	</head>
	<body>
		<Header />
		<main class="container page">
			<h1>标签</h1>
			{tags.length > 0 && <p class="sub">{tags.length} 个标签，作为分类之外的横向索引</p>}
			<div class="cloud">
				{tags.map(([tag, count]) => <a href={tagUrl(tag)}>#{tag}<span>{count}</span></a>)}
			</div>
			{tags.length === 0 && <p class="empty">还没有标签。在文章 frontmatter 里加 tags 即可。</p>}
		</main>
		<Footer />
	</body>
</html>

<style>
	.page {
		padding-top: 3.5rem;
	}
	h1 {
		margin: 0 0 0.2em;
		font-size: 1.9rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	.sub {
		margin: 0 0 2rem;
		color: var(--muted);
		font-size: 0.84rem;
	}
	.cloud {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}
	.cloud a {
		display: inline-flex;
		align-items: baseline;
		gap: 0.4em;
		padding: 0.2em 0.75em;
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--text);
		font-size: 0.86rem;
	}
	.cloud a:hover {
		border-color: var(--line-strong);
		color: var(--accent);
		text-decoration: none;
	}
	.cloud span {
		color: var(--muted);
		font-size: 0.72rem;
		font-variant-numeric: tabular-nums;
	}
	.empty {
		color: var(--muted);
	}
</style>
