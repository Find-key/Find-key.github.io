---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostList from '../../components/PostList.astro';
import { SITE } from '../../consts';
import { allPosts, type Post } from '../../utils/posts';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
	const posts = await allPosts();
	const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

	return tags.map((tag) => ({
		params: { tag },
		props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
	}));
}

interface Props {
	tag: string;
	posts: Post[];
}

const { tag, posts } = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<BaseHead title={`#${tag} · ${SITE.shortTitle}`} description={`标签 ${tag} 下的文章`} />
	</head>
	<body>
		<Header />
		<main class="container page">
			<nav class="crumb" aria-label="位置">
				<a href={withBase('/tags')}>标签</a>
				<span class="sep">/</span>
			</nav>
			<h1>#{tag}</h1>
			<p class="sub">{posts.length} 篇文章</p>
			<PostList posts={posts} />
		</main>
		<Footer />
	</body>
</html>

<style>
	.page {
		padding-top: 3.5rem;
	}
	.crumb {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		color: var(--muted);
		font-size: 0.78rem;
		margin-bottom: 0.9rem;
	}
	.crumb a {
		color: var(--muted);
	}
	.crumb a:hover {
		color: var(--text);
		text-decoration: none;
	}
	.crumb .sep {
		color: var(--line-strong);
	}
	h1 {
		margin: 0 0 0.2em;
		font-size: 1.9rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	.sub {
		margin: 0 0 2rem;
		color: var(--muted);
		font-size: 0.84rem;
	}
</style>
