---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE } from '../consts';

const githubReady = !SITE.github.includes('USERNAME');
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<BaseHead title={`关于 · ${SITE.title}`} description={`关于 ${SITE.author}`} />
	</head>
	<body>
		<Header />
		<main class="container page">
			<article class="prose about">
				<h1>关于</h1>
				<p>
					我是 {SITE.author}，JNU 本科在读。主要的精力放在二进制漏洞上：glibc 的堆、栈和 IO_FILE
					完整走过一遍，现在正慢慢转向 kernel，希望有一天能自己写出一个内核来。
				</p>
				<p>
					对 V8 这类引擎漏洞也保持关注。语言方面在接触 Zig，Rust 读过一部分，目前属于能读懂、
					写起来还吃力的阶段。
				</p>
				<p>
					最近把一部分时间分给了终端安全、病毒分析和免杀，为之后的工作做些准备。
				</p>
				{SITE.email && (
					<p>
						想聊技术、换题目，或者只是打个招呼，都欢迎写信：<a href={`mailto:${SITE.email}`}>{SITE.email}</a>
						{githubReady && (
							<>
								，或者在 <a href={SITE.github} target="_blank" rel="noopener">GitHub</a> 上找我
							</>
						)}
						。
					</p>
				)}
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page {
		padding-top: 3.25rem;
	}
	.about {
		max-width: var(--content-width);
	}
	h1 {
		margin: 0 0 1.3em;
		font-size: 1.9rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}
</style>
