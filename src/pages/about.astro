---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE } from '../consts';
import { withBase } from '../utils/url';
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<BaseHead title={`关于 · ${SITE.title}`} description={`关于 ${SITE.author}`} />
	</head>
	<body>
		<Header />
		<main class="container page">
			<article class="prose">
				<h1>关于</h1>
				<p>
					我是 {SITE.author}，主要折腾二进制漏洞：pwn 题、利用链、逆向和调试。
					这里记那些「当时找了两小时、事后一句话」的细节。
				</p>
				<p>
					<!-- TODO: 换成你自己的自我介绍：现在在做什么、关注什么方向、想在这里写什么 -->
					大部分内容会是 pwn——栈与堆、保护绕过、把别人的 writeup 复现一遍，
					再写下自己卡住的地方。偶尔也会写内核/嵌入式（Buildroot、QEMU 那一套）
					和工具链的东西。纯兴趣驱动，想到什么写什么，不保证体系完整。
				</p>

				<h2>关于这个站</h2>
				<p>
					站点用 <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> 构建，
					纯静态输出，托管在 GitHub Pages 上；没有后端、没有数据库、没有追踪脚本。
					文章按<strong>分类</strong>组织而不是按时间堆叠，读一个主题时可以顺着左侧目录一路往下看。
					构建与项目结构说明见仓库里的 <code>PROJECT.md</code>。
				</p>

				<h2>联系</h2>
				<ul>
					{SITE.github && (
						<li>
							GitHub：<a href={SITE.github} target="_blank" rel="noopener">{SITE.github}</a>
						</li>
					)}
					{SITE.email && (
						<li>
							邮箱：<a href={`mailto:${SITE.email}`}>{SITE.email}</a>
						</li>
					)}
					<li>
						RSS：<a href={withBase('/rss.xml')}>订阅</a>
					</li>
				</ul>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page {
		padding-top: 3.5rem;
	}
	.prose {
		max-width: var(--content-width);
	}
	h1 {
		margin-top: 0;
		font-size: 1.9rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}
</style>
