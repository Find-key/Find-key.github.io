---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { CATEGORIES, SITE } from '../consts';
import { allPosts, groupByCategory } from '../utils/posts';
import { categoryUrl, postUrl, withBase } from '../utils/url';

const posts = await allPosts();
const grouped = groupByCategory(posts);

// 把站名 dump 成 hex（ASCII 部分保留可读），当作顶部的装饰性"页码"
function hexdump(text: string, perLine = 16) {
	const bytes = [...new TextEncoder().encode(text)];
	const out: { offset: string; hex: string; ascii: string }[] = [];
	for (let i = 0; i < bytes.length; i += perLine) {
		const chunk = bytes.slice(i, i + perLine);
		out.push({
			offset: i.toString(16).padStart(8, '0'),
			hex: chunk.map((b) => b.toString(16).padStart(2, '0')).join(' '),
			ascii: chunk.map((b) => (b >= 32 && b < 127 ? String.fromCharCode(b) : '.')).join(''),
		});
	}
	return out;
}
// 一行 dump：ASCII 列是一个 shell 提示符，只有在二进制里泡过的人会读
const rodata = `pwn@${SITE.author.toLowerCase()}:~>`;
const rodataDump = hexdump(rodata)
	.map((line) => `${line.offset}  ${line.hex.padEnd(47, ' ')}  |${line.ascii}|`)
	.join('\n');

const rows = CATEGORIES.map((category) => ({
	category,
	items: grouped.find((g) => g.category.slug === category.slug)?.posts ?? [],
}));
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<BaseHead title={SITE.title} description={SITE.description} />
	</head>
	<body>
		<Header variant="home" />
		<main class="container home">
			<!-- hero：头像 + 名字 + tagline + 一行 dump 出来的 flag + 图标 -->
			<section class="hero">
				<img class="avatar" src={withBase('/avatar.svg')} alt="" width="96" height="96" />
				<div class="who">
					<p class="who-name">{SITE.author}</p>
					{SITE.quote.text && (
						<p class="quote">
							{SITE.quote.text}
							{SITE.quote.by && <span class="quote-by">— {SITE.quote.by}</span>}
						</p>
					)}
					<pre class="flag" aria-hidden="true">{rodataDump}</pre>
					<div class="links">
						{SITE.email && (
							<span class="contact">
								<a class="mail" href={`mailto:${SITE.email}`} aria-label={`发邮件到 ${SITE.email}`}>
									<svg viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="2.5" y="4.5" width="15" height="11" rx="1.5" /><path d="M3 5.5 10 11l7-5.5" /></svg>
									<span class="addr">{SITE.email}</span>
								</a>
								<button class="copy" type="button" data-copy={SITE.email} aria-label="复制邮箱地址">
									<svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="7" y="7" width="9" height="10" rx="1.5" /><path d="M13 7V5.5A1.5 1.5 0 0 0 11.5 4H5.5A1.5 1.5 0 0 0 4 5.5v7A1.5 1.5 0 0 0 5.5 14H7" /></svg>
								</button>
																{SITE.qq && (
									<button
										class="qq"
										type="button"
										data-copy={SITE.qq}
										aria-label={`复制 QQ 号 ${SITE.qq}`}
										title={`QQ ${SITE.qq}`}>
										<svg viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M10 3.2c-3.1 0-5.2 2.2-5.2 5 0 1.3.4 2.3 1 3.2-.5.6-.9 1.4-.9 2 0 .4.2.6.6.5.4-.1.8-.4 1.1-.8.9.7 2.1 1.1 3.4 1.1s2.5-.4 3.4-1.1c.3.4.7.7 1.1.8.4.1.6-.1.6-.5 0-.6-.4-1.4-.9-2 .6-.9 1-1.9 1-3.2 0-2.8-2.1-5-5.2-5Z" /></svg>
										<span class="addr">{SITE.qq}
								<span class="copy-toast" role="status" aria-live="polite"></span>
							</span>
									</button>
								)}

							</span>
						)}

						{!SITE.github.includes('USERNAME') && (
							<a href={SITE.github} target="_blank" rel="noopener" aria-label="GitHub">
								<svg viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M10 2.5a7.5 7.5 0 0 0-2.37 14.62c.37.07.5-.16.5-.36v-1.3c-2.08.45-2.52-1-2.52-1-.34-.87-.83-1.1-.83-1.1-.68-.46.05-.45.05-.45.75.05 1.15.77 1.15.77.67 1.15 1.76.82 2.19.63.07-.49.26-.82.47-1-1.66-.19-3.4-.83-3.4-3.7 0-.82.29-1.49.77-2.01-.08-.19-.34-.95.07-1.98 0 0 .63-.2 2.06.77a7.1 7.1 0 0 1 3.75 0c1.43-.97 2.06-.77 2.06-.77.41 1.03.15 1.79.07 1.98.48.52.77 1.19.77 2.01 0 2.88-1.75 3.51-3.42 3.7.27.23.51.69.51 1.39v2.06c0 .2.13.44.51.36A7.5 7.5 0 0 0 10 2.5Z" /></svg>
							</a>
						)}
					</div>
				</div>
			</section>

			<div class="index-head">
				<span class="label">文章</span>
			</div>

			<div class="spread">
				{rows.length === 0 && (
					<p class="empty">
						还没有文章。先在 <code>src/consts.ts</code> 的 <code>CATEGORIES</code> 里定一个分类，<br
						/>再运行 <code>npm run new</code> 写第一篇。
					</p>
				)}
				{
					rows.map(({ category, items }, i) => (
						<section class="block" id={category.slug}>
							<header class="block-head">
								<span class="num">{String(i + 1).padStart(2, '0')}</span>
								<h2 class="name">
									{items.length > 0 ? (
										<a href={categoryUrl(category.slug)}>{category.name}</a>
									) : (
										<span class="name-plain">{category.name}</span>
									)}
								</h2>
								<span class="count">{items.length > 0 ? `${items.length} 篇` : '还没有文章'}</span>
							</header>

							{items.length > 0 && (
								<ul class="rows">
									{items.slice(0, 3).map((post) => (
										<li>
											<a href={postUrl(post.id)}>
												<span class="line">
													<span class="t">{post.data.title}</span>
													<span class="d">
														<FormattedDate date={post.data.pubDate} format="short" />
													</span>
												</span>
											</a>
										</li>
									))}
								</ul>
							)}

							{items.length > 3 && (
								<p class="more">
									<a href={categoryUrl(category.slug)}>全部 {items.length} 篇 →</a>
								</p>
							)}
						</section>
					))
				}
			</div>

		</main>
		<Footer />
	</body>
</html>

<script>
	// 邮箱图标：复制到剪贴板，并在图标上方浮出「已复制」提示
	const toast = document.querySelector<HTMLElement>('.copy-toast');
	let toastTimer: number | undefined;

	function showToast(text: string) {
		if (!toast) return;
		toast.textContent = text;
		toast.classList.add('show');
		window.clearTimeout(toastTimer);
		toastTimer = window.setTimeout(() => toast.classList.remove('show'), 1600);
	}

	document.querySelectorAll<HTMLElement>('[data-copy]').forEach((button) => {
		button.addEventListener('click', async () => {
			const value = button.dataset.copy;
			if (!value) return;
			try {
				await navigator.clipboard.writeText(value);
				showToast('已复制');
			} catch {
				// 剪贴板不可用（非 https 或无权限）时退回选区复制
				showToast('复制失败');
			}
		});
	});
</script>


<style>
	.home {
		padding-top: 2.25rem;
	}

	/* ---------- hero ---------- */
	.hero {
		display: flex;
		align-items: flex-start;
		gap: 1.6rem;
		padding: 0.5rem 0 2.4rem;
	}
	.avatar {
		flex: none;
		width: 96px;
		height: 96px;
		border-radius: 50%;
	}
	.who {
		min-width: 0;
	}
	.who-name {
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(1.8rem, 3.2vw, 2.25rem);
		font-weight: 500;
		line-height: 1.15;
		letter-spacing: -0.01em;
	}
	/* 题记：衬线正文色 + 行末 mono 署名，像书前的引语 */
	.quote {
		margin: 0.6rem 0 0;
		color: var(--text);
		font-family: var(--font-serif);
		font-size: 1.06rem;
		font-weight: 500;
		line-height: 1.75;
		letter-spacing: 0.005em;
		text-wrap: pretty;
	}
	.quote-by {
		margin-left: 0.5em;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 400;
		letter-spacing: 0.04em;
		white-space: nowrap;
	}
	/* flag 的十六进制形态：等宽、淡墨，ASCII 列读得出 flag{...} */
	.flag {
		margin: 0.95rem 0 0;
		color: rgba(28, 26, 23, 0.5);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		line-height: 1.6;
		letter-spacing: 0.02em;
		white-space: pre;
		overflow-x: auto;
	}
	.links {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		margin-top: 1.15rem;
	}
	.links a {
		color: var(--muted);
		display: inline-flex;
		transition: color 0.15s ease;
	}
	.links a:hover {
		color: var(--text);
	}

	/* 邮箱：图标点击发信；hover 时整条横向展开，露出完整地址 + 复制按钮 */
	.contact {
		position: relative;
		display: inline-flex;
		align-items: center;
		color: var(--muted);
	}
	.contact:hover {
		color: var(--text);
	}
	.mail {
		color: inherit;
		display: inline-flex;
		align-items: center;
	}
	.mail:hover {
		color: inherit;
		text-decoration: none;
	}
	.addr {
		max-width: 0;
		margin-left: 0;
		overflow: hidden;
		opacity: 0;
		white-space: nowrap;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.02em;
		transition:
			max-width 0.3s ease,
			margin-left 0.3s ease,
			opacity 0.22s ease;
	}
	.copy {
		max-width: 0;
		margin-left: 0;
		padding: 0;
		overflow: hidden;
		opacity: 0;
		border: 0;
		background: none;
		color: inherit;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		pointer-events: none;
		transition:
			max-width 0.3s ease,
			margin-left 0.3s ease,
			opacity 0.22s ease;
	}
	.contact:hover .addr,
	.contact:focus-within .addr {
		max-width: 13rem;
		margin-left: 0.5rem;
		opacity: 1;
	}
	.contact:hover .copy,
	.contact:focus-within .copy {
		max-width: 1.2rem;
		margin-left: 0.4rem;
		opacity: 1;
		pointer-events: auto;
	}
	.copy:hover {
		color: var(--text);
	}

	/* QQ：和邮箱同构——一个图标，hover 才展开号码，点击复制 */
	.qq {
		margin-left: 0.75rem;
		display: inline-flex;
		align-items: center;
		padding: 0;
		border: 0;
		background: none;
		color: inherit;
		cursor: pointer;
	}
	.qq:hover .addr,
	.qq:focus-within .addr {
		max-width: 9rem;
		margin-left: 0.45rem;
		opacity: 1;
	}
	/* 复制反馈：展开的地址下方淡入一行小字，1.6s 后消失 */
	.copy-toast {
		position: absolute;
		left: 0;
		top: calc(100% + 0.4rem);
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.66rem;
		letter-spacing: 0.08em;
		white-space: nowrap;
		opacity: 0;
		transform: translateY(-0.1rem);
		pointer-events: none;
		transition:
			opacity 0.18s ease,
			transform 0.18s ease;
	}
	.copy-toast.show {
		opacity: 1;
		transform: none;
	}

	.spread > .empty {
		grid-column: 1 / -1;
		max-width: 40em;
		margin: 0.4rem 0 0;
		color: var(--muted);
		font-size: 0.92rem;
		line-height: 2;
		text-wrap: pretty;
	}
	.spread > .empty code {
		padding: 0 0.2em;
		color: var(--text);
		font-family: var(--font-mono);
		font-size: 0.86em;
	}
	.index-head {
		padding-bottom: 0.9rem;
		border-bottom: 1px solid var(--line-strong);
	}

	/* ---------- 分类分组（2×2） ---------- */
	/* 双栏跨页：左栏两格、右栏两格，组内只露最近 3 篇 */
	.spread {
		display: grid;
		grid-template-columns: 1fr 1fr;
		column-gap: 4rem;
		row-gap: 2.6rem;
		align-items: start;
		padding-top: 1.75rem;
	}
	/* 分组标签小而轻：这一页的主角是文章标题，不是分类名 */
	/* 分组数是奇数时，最后一格横跨两栏，避免右半边空一大块 */
	.block:last-child:nth-child(odd) {
		grid-column: 1 / -1;
	}
	.block-head {
		display: flex;
		align-items: baseline;
		gap: 0.55rem;
		padding-bottom: 0.55rem;
		border-bottom: 1px solid var(--line);
	}
	.block-head .count {
		margin-left: auto;
	}
	.num {
		color: var(--line-strong);
		font-family: var(--font-mono);
		font-size: 0.66rem;
		letter-spacing: 0.08em;
	}
	.name {
		flex: 0 1 auto;
		margin: 0;
		font-size: 0.9rem;
		font-weight: 500;
		line-height: 1.4;
		letter-spacing: 0.02em;
	}
	.name a {
		color: var(--text);
	}
	.name a:hover {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-decoration-color: var(--line-strong);
		text-underline-offset: 0.22em;
	}
	.name-plain {
		color: var(--muted);
	}
	.count {
		flex: none;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		white-space: nowrap;
	}

	.rows {
		margin: 0.85rem 0 0;
		padding: 0;
		list-style: none;
	}
	.rows li + li {
		margin-top: 0.6rem;
		padding-top: 0.6rem;
		/* 比分组那条线淡一档，避免整页被横线切碎 */
		border-top: 1px solid var(--line-soft);
	}
	.rows a {
		display: block;
	}
	.rows a:hover,
	.rows a:hover .t {
		text-decoration: none;
	}
	.rows a:hover .t {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-decoration-color: var(--line-strong);
		text-underline-offset: 0.22em;
	}
	.line {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.8rem;
	}
	.t {
		color: var(--text);
		font-family: var(--font-serif);
		font-size: 1.06rem;
		font-weight: 600;
		line-height: 1.5;
	}
	.d {
		flex: none;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.66rem;
		white-space: nowrap;
	}
	.more {
		margin: 0.75rem 0 0;
		text-align: right;
		font-size: 0.78rem;
	}
	.more a {
		color: var(--muted);
	}
	.more a:hover {
		color: var(--text);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-decoration-color: var(--line-strong);
		text-underline-offset: 0.22em;
	}


	@media (max-width: 760px) {
		/* 触屏没有 hover：地址与复制按钮一直显示 */
		.addr {
			max-width: 13rem;
			margin-left: 0.45rem;
			opacity: 1;
		}
		.copy {
			max-width: 1.2rem;
			margin-left: 0.4rem;
			opacity: 1;
			pointer-events: auto;
		}
		/* 手机上一行 dump 太长，横滚还不如不要 */
		.flag {
			display: none;
		}
		.avatar {
			width: 64px;
			height: 64px;
		}
		.hero {
			gap: 1.1rem;
		}
		.spread {
			grid-template-columns: 1fr;
			row-gap: 2.2rem;
		}
		.name {
			font-size: 1.28rem;
		}
		.intro {
			gap: 1rem;
		}
		.photo {
			width: 56px;
			height: 56px;
		}
		.bio p {
			font-size: 1.08rem;
		}
		.bio p + p {
			font-size: 0.94rem;
		}
	}
</style>