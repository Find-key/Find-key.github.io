---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { CATEGORIES, SITE } from '../consts';
import { allPosts, groupByCategory } from '../utils/posts';
import { categoryUrl, postUrl, withBase } from '../utils/url';

const posts = await allPosts();
const grouped = groupByCategory(posts);

// 把站名 dump 成 hex（ASCII 部分保留可读），当作顶部的装饰性"页码"
function hexdump(text: string, perLine = 16) {
	const bytes = [...new TextEncoder().encode(text)];
	const out: { offset: string; hex: string; ascii: string }[] = [];
	for (let i = 0; i < bytes.length; i += perLine) {
		const chunk = bytes.slice(i, i + perLine);
		out.push({
			offset: i.toString(16).padStart(8, '0'),
			hex: chunk.map((b) => b.toString(16).padStart(2, '0')).join(' '),
			ascii: chunk.map((b) => (b >= 32 && b < 127 ? String.fromCharCode(b) : '.')).join(''),
		});
	}
	return out;
}
// 一行 dump：ASCII 列是一个 shell 提示符，只有在二进制里泡过的人会读
const rodata = `pwn@${SITE.author.toLowerCase()}:~>`;
const rodataDump = hexdump(rodata)
	.map((line) => `${line.offset}  ${line.hex.padEnd(47, ' ')}  |${line.ascii}|`)
	.join('\n');

const rows = CATEGORIES.map((category) => ({
	category,
	items: grouped.find((g) => g.category.slug === category.slug)?.posts ?? [],
}));
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<BaseHead title={SITE.title} description={SITE.description} />
	</head>
	<body>
		<Header variant="home" />
		<main class="container home">
			<!-- hero：头像 + 名字 + tagline + 一行 dump 出来的 flag + 图标 -->
			<section class="hero">
				<img class="avatar" src={withBase('/avatar.svg')} alt="" width="96" height="96" />
				<div class="who">
					<p class="who-name">{SITE.author}</p>
					{SITE.quote.text && (
						<p class="quote">
							{SITE.quote.text}
							{SITE.quote.by && <span class="quote-by">— {SITE.quote.by}</span>}
						</p>
					)}
					<pre class="flag" aria-hidden="true">{rodataDump}</pre>
					<div class="links">
						{SITE.email && (
							<a href={`mailto:${SITE.email}`} aria-label="邮箱">
								<svg viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="2.5" y="4.5" width="15" height="11" rx="1.5" /><path d="M3 5.5 10 11l7-5.5" /></svg>
							</a>
						)}
						<a href={withBase('/rss.xml')} aria-label="RSS">
							<svg viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M4 4a12 12 0 0 1 12 12" /><path d="M4 9a7 7 0 0 1 7 7" /><circle cx="5" cy="15" r="1.4" fill="currentColor" stroke="none" /></svg>
						</a>
						{!SITE.github.includes('USERNAME') && (
							<a href={SITE.github} target="_blank" rel="noopener" aria-label="GitHub">
								<svg viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M10 2.5a7.5 7.5 0 0 0-2.37 14.62c.37.07.5-.16.5-.36v-1.3c-2.08.45-2.52-1-2.52-1-.34-.87-.83-1.1-.83-1.1-.68-.46.05-.45.05-.45.75.05 1.15.77 1.15.77.67 1.15 1.76.82 2.19.63.07-.49.26-.82.47-1-1.66-.19-3.4-.83-3.4-3.7 0-.82.29-1.49.77-2.01-.08-.19-.34-.95.07-1.98 0 0 .63-.2 2.06.77a7.1 7.1 0 0 1 3.75 0c1.43-.97 2.06-.77 2.06-.77.41 1.03.15 1.79.07 1.98.48.52.77 1.19.77 2.01 0 2.88-1.75 3.51-3.42 3.7.27.23.51.69.51 1.39v2.06c0 .2.13.44.51.36A7.5 7.5 0 0 0 10 2.5Z" /></svg>
							</a>
						)}
					</div>
				</div>
			</section>

			<div class="index-head">
				<span class="label">文章</span>
			</div>

			<div class="spread">
				{
					rows.map(({ category, items }, i) => (
						<section class="block" id={category.slug}>
							<header class="block-head">
								<span class="num">{String(i + 1).padStart(2, '0')}</span>
								<h2 class="name">
									{items.length > 0 ? (
										<a href={categoryUrl(category.slug)}>{category.name}</a>
									) : (
										<span class="name-plain">{category.name}</span>
									)}
								</h2>
								<span class="count">{items.length > 0 ? `${items.length} 篇` : '还没有文章'}</span>
							</header>

							{items.length > 0 && (
								<ul class="rows">
									{items.slice(0, 3).map((post) => (
										<li>
											<a href={postUrl(post.id)}>
												<span class="line">
													<span class="t">{post.data.title}</span>
													<span class="d">
														<FormattedDate date={post.data.pubDate} format="short" />
													</span>
												</span>
											</a>
										</li>
									))}
								</ul>
							)}

							{items.length > 3 && (
								<p class="more">
									<a href={categoryUrl(category.slug)}>全部 {items.length} 篇 →</a>
								</p>
							)}
						</section>
					))
				}
			</div>

		</main>
		<Footer />
	</body>
</html>

<style>
	.home {
		padding-top: 2.25rem;
	}

	/* ---------- hero ---------- */
	.hero {
		display: flex;
		align-items: flex-start;
		gap: 1.6rem;
		padding: 0.5rem 0 2.4rem;
	}
	.avatar {
		flex: none;
		width: 96px;
		height: 96px;
		border-radius: 50%;
	}
	.who {
		min-width: 0;
	}
	.who-name {
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(1.8rem, 3.2vw, 2.25rem);
		font-weight: 500;
		line-height: 1.15;
		letter-spacing: -0.01em;
	}
	/* 题记：衬线正文色 + 行末 mono 署名，像书前的引语 */
	.quote {
		margin: 0.6rem 0 0;
		color: var(--text);
		font-family: var(--font-serif);
		font-size: 1.06rem;
		font-weight: 500;
		line-height: 1.75;
		letter-spacing: 0.005em;
		text-wrap: pretty;
	}
	.quote-by {
		margin-left: 0.5em;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 400;
		letter-spacing: 0.04em;
		white-space: nowrap;
	}
	/* flag 的十六进制形态：等宽、淡墨，ASCII 列读得出 flag{...} */
	.flag {
		margin: 0.95rem 0 0;
		color: rgba(28, 26, 23, 0.5);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		line-height: 1.6;
		letter-spacing: 0.02em;
		white-space: pre;
		overflow-x: auto;
	}
	.links {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		margin-top: 1.15rem;
	}
	.links a {
		color: var(--muted);
		display: inline-flex;
		transition: color 0.15s ease;
	}
	.links a:hover {
		color: var(--accent);
	}

	.index-head {
		padding-bottom: 0.9rem;
		border-bottom: 1px solid var(--text);
	}

	/* ---------- 分类分组（2×2） ---------- */
	/* 双栏跨页：左栏两格、右栏两格，组内只露最近 3 篇 */
	.spread {
		display: grid;
		grid-template-columns: 1fr 1fr;
		column-gap: 4rem;
		row-gap: 2.6rem;
		align-items: start;
		padding-top: 1.75rem;
	}
	/* 分组标签小而轻：这一页的主角是文章标题，不是分类名 */
	.block-head {
		display: flex;
		align-items: baseline;
		gap: 0.55rem;
		padding-bottom: 0.55rem;
		border-bottom: 1px solid var(--line);
	}
	.block-head .count {
		margin-left: auto;
	}
	.num {
		color: var(--line-strong);
		font-family: var(--font-mono);
		font-size: 0.66rem;
		letter-spacing: 0.08em;
	}
	.name {
		flex: 0 1 auto;
		margin: 0;
		font-size: 0.9rem;
		font-weight: 500;
		line-height: 1.4;
		letter-spacing: 0.02em;
	}
	.name a {
		color: var(--text);
	}
	.name a:hover {
		color: var(--accent);
		text-decoration: none;
	}
	.name-plain {
		color: var(--muted);
	}
	.count {
		flex: none;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		white-space: nowrap;
	}

	.rows {
		margin: 0.85rem 0 0;
		padding: 0;
		list-style: none;
	}
	.rows li + li {
		margin-top: 0.6rem;
		padding-top: 0.6rem;
		border-top: 1px solid var(--line);
	}
	.rows a {
		display: block;
	}
	.rows a:hover {
		text-decoration: none;
	}
	.rows a:hover .t {
		color: var(--accent);
	}
	.line {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.8rem;
	}
	.t {
		color: var(--text);
		font-family: var(--font-serif);
		font-size: 1.06rem;
		font-weight: 600;
		line-height: 1.5;
	}
	.d {
		flex: none;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.66rem;
		white-space: nowrap;
	}
	.more {
		margin: 0.7rem 0 0;
		font-size: 0.8rem;
	}


	@media (max-width: 760px) {
		/* 手机上一行 dump 太长，横滚还不如不要 */
		.flag {
			display: none;
		}
		.avatar {
			width: 64px;
			height: 64px;
		}
		.hero {
			gap: 1.1rem;
		}
		.spread {
			grid-template-columns: 1fr;
			row-gap: 2.2rem;
		}
		.name {
			font-size: 1.28rem;
		}
		.intro {
			gap: 1rem;
		}
		.photo {
			width: 56px;
			height: 56px;
		}
		.bio p {
			font-size: 1.08rem;
		}
		.bio p + p {
			font-size: 0.94rem;
		}
	}
</style>
