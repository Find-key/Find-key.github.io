---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { CATEGORIES, SITE } from '../consts';
import { allPosts, groupByCategory } from '../utils/posts';
import { categoryUrl, postUrl, withBase } from '../utils/url';

const posts = await allPosts();
const grouped = groupByCategory(posts);

// 首页 = 分类目录（跨页式）：按 CATEGORIES 全量列出，空分类标注"还没有文章"
const rows = CATEGORIES.map((category) => ({
	category,
	items: grouped.find((g) => g.category.slug === category.slug)?.posts ?? [],
}));
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<BaseHead title={SITE.title} description={SITE.description} />
	</head>
	<body>
		<Header variant="home" />
		<main class="container home">
			<section class="intro">
				<img class="avatar" src={withBase('/avatar.svg')} alt="" width="72" height="72" />
				<blockquote class="quote">
					<span data-hito>过早优化是万恶之源。</span>
				</blockquote>
				<p class="src" data-hito-src>— Donald Knuth</p>
			</section>

			<div class="index-head">
				<span class="label">文章</span>
			</div>

			<div class="spread">
				{
					rows.map(({ category, items }, i) => (
						<section class="block" id={category.slug}>
							<header class="block-head">
								<span class="num">{String(i + 1).padStart(2, '0')}</span>
								<h2 class="name">
									{items.length > 0 ? (
										/* 空分类没有详情页，就不能给链接 */
										<a href={categoryUrl(category.slug)}>{category.name}</a>
									) : (
										<span class="name-plain">{category.name}</span>
									)}
								</h2>
								<span class="count">{items.length > 0 ? `${items.length} 篇` : '还没有文章'}</span>
							</header>

							{items.length > 0 && (
								<ul class="rows">
									{items.slice(0, 3).map((post) => (
										<li>
											<a href={postUrl(post.id)}>
												<span class="t">{post.data.title}</span>
												<span class="d">
													<FormattedDate date={post.data.pubDate} format="short" />
												</span>
											</a>
										</li>
									))}
								</ul>
							)}

							{items.length > 3 && (
								<p class="more">
									<a href={categoryUrl(category.slug)}>全部 {items.length} 篇 →</a>
								</p>
							)}
						</section>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>

<script>
	// 一言：静态构建时先放一句兜底，页面加载后再去换。
	// 拿不到就保持兜底，不做任何占位骨架、不阻塞渲染。
	const quote = document.querySelector('[data-hito]');
	const source = document.querySelector('[data-hito-src]');

	fetch('https://v1.hitokoto.cn/?encode=json&max_length=44')
		.then((response) => (response.ok ? response.json() : Promise.reject(response.status)))
		.then((data: { hitokoto?: string; from_who?: string; from?: string }) => {
			if (!quote || !data.hitokoto) return;
			quote.textContent = data.hitokoto;
			if (source) {
				// from_who 和 from 常常是同一个名字，别拼成"某某 · 某某"
				const who = (data.from_who ?? '').trim();
				const what = (data.from ?? '').trim();
				const clean = who && what && who !== what ? `${who} · ${what}` : who || what;
				source.textContent = clean ? `— ${clean}` : '';
			}
		})
		.catch(() => {
			/* 离线或被墙时静默失败，保留兜底那句 */
		});
</script>

<style>
	.home {
		padding-top: 2.75rem;
	}

	/* ---------- 头像 + 一言 ---------- */
	/* 头像在上、引文居中、出处在下：一整组居中，左右天然对称，
	   不会像"头像靠左 + 出处甩到最右"那样中间空一大片。 */
	.intro {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.15rem;
		padding: 1.6rem 0 3rem;
		text-align: center;
	}
	.avatar {
		width: 72px;
		height: 72px;
		border-radius: 50%;
	}
	.quote {
		max-width: 30em;
		margin: 0;
		color: var(--text);
		font-family: var(--font-serif);
		font-size: 1.28rem;
		font-weight: 500;
		line-height: 1.75;
		letter-spacing: 0;
		text-wrap: balance;
	}
	.src {
		margin: 0;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.06em;
	}
	.src:empty {
		display: none;
	}
	@media (max-width: 560px) {
		.intro {
			gap: 0.9rem;
			padding: 1rem 0 2.4rem;
		}
		.avatar {
			width: 60px;
			height: 60px;
		}
		.quote {
			font-size: 1.1rem;
		}
	}

	.index-head {
		padding-bottom: 0.9rem;
		border-bottom: 1px solid var(--text);
	}

	/* 跨页式：两栏分类，栏间靠留白分开，每个分类顶上一道发丝线 */
	.spread {
		display: grid;
		grid-template-columns: 1fr 1fr;
		column-gap: 3.5rem;
		row-gap: 2.9rem;
	}

	.block {
		padding-top: 1.15rem;
		border-top: 1px solid var(--line);
	}

	.block-head {
		display: flex;
		align-items: baseline;
		gap: 0.7rem;
	}
	.num {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.1em;
	}
	.name {
		flex: 1;
		margin: 0;
		font-size: 1.5rem;
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: -0.005em;
	}
	.name a {
		color: var(--text);
	}
	.name a:hover {
		color: var(--accent);
		text-decoration: none;
	}
	.name-plain {
		color: var(--muted);
	}
	.count {
		flex: none;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		white-space: nowrap;
	}

	.rows {
		margin: 0.75rem 0 0;
		padding: 0;
		list-style: none;
	}
	.rows li + li {
		border-top: 1px solid var(--line);
	}
	.rows a {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.5rem 0;
	}
	/* 整行是链接，但悬停只变字色，不画下划线（下划线留给正文里的链接） */
	.rows a:hover {
		text-decoration: none;
	}
	.rows a:hover .t {
		color: var(--accent);
	}
	.t {
		color: var(--text);
		font-family: var(--font-serif);
		font-size: 0.98rem;
		font-weight: 600;
		line-height: 1.5;
	}
	.d {
		flex: none;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.66rem;
		white-space: nowrap;
	}

	.more {
		margin: 0.6rem 0 0;
		font-size: 0.8rem;
	}

	@media (max-width: 720px) {
		.spread {
			grid-template-columns: 1fr;
			row-gap: 2.2rem;
		}
		.name {
			font-size: 1.3rem;
		}
	}
</style>
