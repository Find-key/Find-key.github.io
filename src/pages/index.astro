---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { CATEGORIES, SITE } from '../consts';
import { allPosts, groupByCategory } from '../utils/posts';
import { categoryUrl, postUrl, withBase } from '../utils/url';

const posts = await allPosts();
const grouped = groupByCategory(posts);

const rows = CATEGORIES.map((category) => ({
	category,
	items: grouped.find((g) => g.category.slug === category.slug)?.posts ?? [],
}));
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<BaseHead title={SITE.title} description={SITE.description} />
	</head>
	<body>
		<Header variant="home" />
		<main class="container home">
			<!-- 顶部：两行第一人称 + 右上小照片（照片有明确职责：它就是这个说话的人） -->
			<section class="intro">
				<div class="bio">
					{SITE.intro.map((line) => <p>{line}</p>)}
				</div>
				<img class="photo" src={withBase('/avatar.svg')} alt="" width="84" height="84" />
			</section>

			<div class="index-head">
				<span class="label">文章</span>
			</div>

			<div class="spread">
				{
					rows.map(({ category, items }, i) => (
						<section class="block" id={category.slug}>
							<header class="block-head">
								<span class="num">{String(i + 1).padStart(2, '0')}</span>
								<h2 class="name">
									{items.length > 0 ? (
										<a href={categoryUrl(category.slug)}>{category.name}</a>
									) : (
										<span class="name-plain">{category.name}</span>
									)}
								</h2>
								<span class="count">{items.length > 0 ? `${items.length} 篇` : '还没有文章'}</span>
							</header>

							{items.length > 0 && (
								<ul class="rows">
									{items.slice(0, 3).map((post) => (
										<li>
											<a href={postUrl(post.id)}>
												<span class="line">
													<span class="t">{post.data.title}</span>
													<span class="d">
														<FormattedDate date={post.data.pubDate} format="short" />
													</span>
												</span>
												<span class="desc">{post.data.description}</span>
											</a>
										</li>
									))}
								</ul>
							)}

							{items.length > 3 && (
								<p class="more">
									<a href={categoryUrl(category.slug)}>全部 {items.length} 篇 →</a>
								</p>
							)}
						</section>
					))
				}
			</div>

			<!-- 页尾一句：位置和 paco.me 的 Now 一样，但当收尾而不是开头 -->
			<section class="closing">
				<p class="quote" data-hito>过早优化是万恶之源。</p>
				<p class="src" data-hito-src>— Donald Knuth</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<script>
	// 一言：构建时先把兜底那句渲染进 HTML，加载后再换成随机的；失败保持兜底。
	const quote = document.querySelector('[data-hito]');
	const source = document.querySelector('[data-hito-src]');

	fetch('https://v1.hitokoto.cn/?encode=json&max_length=44')
		.then((response) => (response.ok ? response.json() : Promise.reject(response.status)))
		.then((data: { hitokoto?: string; from_who?: string; from?: string }) => {
			if (!quote || !data.hitokoto) return;
			quote.textContent = data.hitokoto;
			if (source) {
				const who = (data.from_who ?? '').trim();
				const what = (data.from ?? '').trim();
				const clean = who && what && who !== what ? `${who} · ${what}` : who || what;
				source.textContent = clean ? `— ${clean}` : '';
			}
		})
		.catch(() => {
			/* 离线或被墙时保留兜底 */
		});
</script>

<style>
	.home {
		padding-top: 2.25rem;
	}

	/* ---------- 顶部：自述 + 照片 ---------- */
	.intro {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 2rem;
		padding: 0.25rem 0 3.1rem;
	}
	.bio {
		max-width: 34em;
		padding-top: 0.2rem;
	}
	.bio p {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 1.2rem;
		line-height: 1.82;
		letter-spacing: 0;
		text-wrap: pretty;
	}
	.bio p + p {
		color: var(--muted);
		font-size: 1rem;
	}
	/* 小照片：方角、一圈发丝边，像贴在纸上的证件照 */
	.photo {
		flex: none;
		width: 76px;
		height: 76px;
		border: 1px solid var(--line);
		border-radius: 2px;
	}

	.index-head {
		padding-bottom: 0.9rem;
		border-bottom: 1px solid var(--text);
	}

	/* ---------- 分类分组（2×2） ---------- */
	/* 单栏：文章量还少，双栏会出现半空格子；一栏一条往下读更稳。
	   文章多起来也不受影响（每组只露最近 3 篇 + 「全部 N 篇」）。 */
	.spread {
		display: grid;
		grid-template-columns: 1fr;
		row-gap: 2.2rem;
		padding-top: 1.75rem;
	}
	/* 分组标签小而轻：这一页的主角是文章标题，不是分类名 */
	.block-head {
		display: flex;
		align-items: baseline;
		gap: 0.55rem;
		padding-bottom: 0.55rem;
		border-bottom: 1px solid var(--line);
	}
	.block-head .count {
		margin-left: auto;
	}
	.num {
		color: var(--line-strong);
		font-family: var(--font-mono);
		font-size: 0.66rem;
		letter-spacing: 0.08em;
	}
	.name {
		flex: 0 1 auto;
		margin: 0;
		font-size: 0.9rem;
		font-weight: 500;
		line-height: 1.4;
		letter-spacing: 0.02em;
	}
	.name a {
		color: var(--text);
	}
	.name a:hover {
		color: var(--accent);
		text-decoration: none;
	}
	.name-plain {
		color: var(--muted);
	}
	.count {
		flex: none;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		white-space: nowrap;
	}

	.rows {
		margin: 0.85rem 0 0;
		padding: 0;
		list-style: none;
	}
	.rows li + li {
		margin-top: 1.05rem;
	}
	.rows a {
		display: block;
	}
	.rows a:hover {
		text-decoration: none;
	}
	.rows a:hover .t {
		color: var(--accent);
	}
	.line {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.8rem;
	}
	.t {
		color: var(--text);
		font-family: var(--font-serif);
		font-size: 1.06rem;
		font-weight: 600;
		line-height: 1.5;
	}
	.d {
		flex: none;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.66rem;
		white-space: nowrap;
	}
	.desc {
		display: block;
		margin-top: 0.25rem;
		color: var(--muted);
		font-family: var(--font-serif);
		font-size: 0.88rem;
		line-height: 1.7;
		text-wrap: pretty;
	}
	.more {
		margin: 0.7rem 0 0;
		font-size: 0.8rem;
	}

	/* ---------- 页尾一句 ---------- */
	.closing {
		margin-top: 3rem;
		padding-top: 1.4rem;
		border-top: 1px solid var(--line);
	}
	.quote {
		max-width: 34em;
		margin: 0;
		color: var(--text);
		font-family: var(--font-serif);
		font-size: 1rem;
		line-height: 1.75;
		text-wrap: pretty;
	}
	.src {
		margin: 0.35rem 0 0;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.66rem;
		letter-spacing: 0.05em;
	}
	.src:empty {
		display: none;
	}

	@media (max-width: 760px) {
		.spread {
			grid-template-columns: 1fr;
			row-gap: 2.2rem;
		}
		.name {
			font-size: 1.28rem;
		}
		.intro {
			gap: 1rem;
		}
		.photo {
			width: 56px;
			height: 56px;
		}
		.bio p {
			font-size: 1.08rem;
		}
		.bio p + p {
			font-size: 0.94rem;
		}
	}
</style>
