---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { FRIENDS, SITE } from '../consts';
import { withBase } from '../utils/url';

const host = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');
const initial = (name: string) => name.trim().slice(0, 1).toUpperCase();
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<BaseHead title={`友链 · ${SITE.title}`} description={`${SITE.title} 的友情链接`} />
	</head>
	<body>
		<Header />
		<main class="container page">
			<h1>友链</h1>
			<p class="sub">常看的站点和朋友的主页</p>

			{
				FRIENDS.length > 0 ? (
					<ul class="friends">
						{FRIENDS.map((friend) => (
							<li>
								<a href={friend.url} target="_blank" rel="noopener">
									<span class="avatar" aria-hidden="true">
										<span class="initial">{initial(friend.name)}</span>
										{friend.avatar && (
											<img
												src={friend.avatar.startsWith('/') ? withBase(friend.avatar) : friend.avatar}
												alt=""
												width="40"
												height="40"
												loading="lazy"
												referrerpolicy="no-referrer"
												onerror="this.remove()"
											/>
										)}
									</span>
									<span class="who">
										<span class="line">
											<span class="name">{friend.name}</span>
											<span class="host">{host(friend.url)}</span>
										</span>
										{friend.note && <span class="note">{friend.note}</span>}
									</span>
								</a>
							</li>
						))}
					</ul>
				) : (
					<div class="empty">
						<p>还没有友链。</p>
						<p class="hint">
							想交换链接的话，写信给我：
							{SITE.email ? <span class="mail">{SITE.email}</span> : '（邮箱待填）'}
						</p>
					</div>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.page {
		padding-top: 3.5rem;
	}
	h1 {
		margin: 0 0 0.2em;
		font-size: 1.9rem;
		font-weight: 600;
		letter-spacing: -0.005em;
	}
	.sub {
		margin: 0 0 2.5rem;
		color: var(--muted);
		font-size: 0.84rem;
	}

	/* 双栏：单栏 16 条会拉成一条细长的空列表 */
	.friends {
		display: grid;
		grid-template-columns: 1fr 1fr;
		column-gap: 3.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.friends li {
		border-bottom: 1px solid var(--line-soft);
	}
	.friends a {
		display: flex;
		align-items: flex-start;
		gap: 0.8rem;
		padding: 0.85rem 0;
	}
	.friends a:hover {
		text-decoration: none;
	}

	/* 头像：外链图加载失败时下面垫着首字母，不会出现破图 */
	.avatar {
		position: relative;
		display: grid;
		place-items: center;
		flex: none;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		overflow: hidden;
		background: var(--code-bg);
	}
	.avatar .initial {
		position: absolute;
		color: var(--muted);
		font-family: var(--font-serif);
		font-size: 0.95rem;
		line-height: 1;
	}
	/* 图片存在时隐藏底层首字母，避免透明头像透出底字；图片 onerror 移除后首字母自动显现 */
	.avatar:has(img) .initial {
		display: none;
	}
	.avatar img {
		position: relative;
		width: 40px;
		height: 40px;
		object-fit: cover;
		display: block;
	}

	.who {
		min-width: 0;
		flex: 1;
	}
	.line {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.9rem;
	}
	.name {
		font-family: var(--font-serif);
		color: var(--text);
		font-size: 1.02rem;
		font-weight: 600;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.friends a:hover .name {
		text-decoration: underline;
		text-decoration-color: var(--line-strong);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
	}
	.host {
		flex: none;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.66rem;
		letter-spacing: 0.02em;
		opacity: 0.85;
	}
	.note {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		margin-top: 0.15rem;
		color: var(--muted);
		font-size: 0.82rem;
		line-height: 1.65;
		text-wrap: pretty;
	}

	@media (max-width: 820px) {
		.friends {
			grid-template-columns: 1fr;
			column-gap: 0;
		}
	}

	/* 空状态也要像设计过的，而不是坏掉 */
	.empty {
		padding: 1.5rem 0;
		border-top: 1px solid var(--line);
		color: var(--text);
	}
	.empty p {
		margin: 0 0 0.7rem;
		font-size: 0.92rem;
	}
	.hint {
		color: var(--muted);
		font-size: 0.85rem !important;
	}
</style>
