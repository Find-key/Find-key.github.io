---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { FRIENDS, SITE } from '../consts';

const host = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<BaseHead
			title={`友链 · ${SITE.title}`}
			description={`${SITE.title} 的友情链接`}
		/>
	</head>
	<body>
		<Header />
		<main class="container page">
			<h1>友链</h1>
			<p class="sub">常看的站点和朋友的主页</p>

			{
				FRIENDS.length > 0 ? (
					<ul class="friends">
						{FRIENDS.map((friend) => (
							<li>
								<a href={friend.url} target="_blank" rel="noopener">
									<span class="line">
										<span class="name">{friend.name}</span>
										<span class="host">{host(friend.url)}</span>
									</span>
									{friend.note && <span class="note">{friend.note}</span>}
								</a>
							</li>
						))}
					</ul>
				) : (
					<div class="empty">
						<p>还没有友链。</p>
						<p class="hint">
							想交换链接的话，写信给我：
							{SITE.email ? <a href={`mailto:${SITE.email}`}>{SITE.email}</a> : '（邮箱待填）'}
						</p>
					</div>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.page {
		padding-top: 3.5rem;
	}
	h1 {
		margin: 0 0 0.2em;
		font-size: 1.9rem;
		font-weight: 600;
		letter-spacing: -0.005em;
	}
	.sub {
		margin: 0 0 2.5rem;
		color: var(--muted);
		font-size: 0.84rem;
	}
	.friends {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.friends li {
		border-bottom: 1px solid var(--line);
	}
	.friends a {
		display: block;
		padding: 1.05rem 0;
	}
	.friends a:hover {
		text-decoration: none;
	}
	.line {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.25rem;
	}
	.name {
		font-family: var(--font-serif);
		color: var(--text);
		font-size: 1.07rem;
		font-weight: 600;
	}
	.friends a:hover .name {
		color: var(--accent);
	}
	.host {
		flex: none;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.02em;
	}
	.note {
		display: block;
		margin-top: 0.2rem;
		color: var(--muted);
		font-size: 0.85rem;
		line-height: 1.7;
		text-wrap: pretty;
	}

	/* 空状态也要像设计过的，而不是坏掉 */
	.empty {
		padding: 1.5rem 0;
		border-top: 1px solid var(--line);
		color: var(--text);
	}
	.empty p {
		margin: 0 0 0.7rem;
		font-size: 0.92rem;
	}
	.hint {
		color: var(--muted);
		font-size: 0.85rem !important;
	}
</style>
