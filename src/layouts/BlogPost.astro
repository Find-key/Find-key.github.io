---
/**
 * 文章页布局：左侧分类目录 + 右侧正文（单栏，正文约 40 字宽）。
 * 上一版是"居中大标题 + 封面图 + 渐变背景"，读长文很累，这一版按文档站的方式排。
 */
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import 'katex/dist/katex.min.css';
import CodeTools from '../components/CodeTools.astro';
import BaseHead from '../components/BaseHead.astro';
import Toc from '../components/Toc.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE } from '../consts';
import {
	categoryOf,
	isVisible,
	postsOfCategory,
	readingMinutes,
	sortForReading,
	type Post,
} from '../utils/posts';
import { categoryUrl, postUrl, tagUrl, withBase } from '../utils/url';

interface Props {
	post: CollectionEntry<'blog'>;
	headings?: { depth: number; slug: string; text: string }[];
}

const { post, headings = [] } = Astro.props;
const { title, description, pubDate, updatedDate, tags, category: categorySlug } = post.data;

const category = categoryOf(categorySlug);
const all = (await getCollection('blog', isVisible)).sort(sortForReading);
const siblings: Post[] = postsOfCategory(all, categorySlug);
const index = siblings.findIndex((item) => item.id === post.id);
const prev = index > 0 ? siblings[index - 1] : undefined;
const next = index >= 0 && index < siblings.length - 1 ? siblings[index + 1] : undefined;
const minutes = readingMinutes(post.body);
---

<html lang={SITE.lang}>
	<head>
		<BaseHead title={`${title} · ${SITE.title}`} description={description} type="article" />
	</head>

	<body>
		<Header />
		<main class="wrap">
			<div class="grid">
				<Toc headings={headings} />

				<article class="article">
					<nav class="crumb" aria-label="位置">
						<a href={withBase('/')}>首页</a>
						{category && (
							<>
								<span class="sep">/</span>
								<a href={categoryUrl(category.slug)}>{category.name}</a>
							</>
						)}
					</nav>

					<h1>{title}</h1>

					<p class="meta">
						<FormattedDate date={pubDate} />
						<span class="dot">·</span>
						<span>约 {minutes} 分钟</span>
						{
							updatedDate && (
								<>
									<span class="dot">·</span>
									<span>
										更新于 <FormattedDate date={updatedDate} format="short" />
									</span>
								</>
							)
						}
					</p>

					{
						tags.length > 0 && (
							<div class="tags">
								{tags.map((tag) => (
									<a href={tagUrl(tag)}>#{tag}</a>
								))}
							</div>
						)
					}

					<Toc headings={headings} variant="inline" />

					<div class="prose">
						<slot />
					</div>

					{
						(prev || next) && (
							<nav class="pager" aria-label="同分类内的上一篇 / 下一篇">
								<div class="pager-item">
									{prev && (
										<>
											<span class="pager-label">← 上一篇</span>
											<a href={postUrl(prev.id)}>{prev.data.title}</a>
										</>
									)}
								</div>
								<div class="pager-item next">
									{next && (
										<>
											<span class="pager-label">下一篇 →</span>
											<a href={postUrl(next.id)}>{next.data.title}</a>
										</>
									)}
								</div>
							</nav>
						)
					}
				</article>
			</div>
		</main>
		<Footer />
		<CodeTools />
	</body>
</html>

<style>
	.wrap {
		max-width: var(--page-width);
		margin: 0 auto;
		padding: 3rem 1.25rem 0;
	}
	.grid {
		display: grid;
		grid-template-columns: 208px minmax(0, 1fr);
		gap: 3rem;
		align-items: start;
	}
	.article {
		max-width: 100%;
		min-width: 0;
	}
	.crumb {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.06em;
	}
	.crumb a {
		color: var(--muted);
	}
	.crumb a:hover {
		color: var(--text);
		text-decoration: none;
	}
	.crumb .sep {
		color: var(--line-strong);
	}
	h1 {
		margin: 0.5em 0 0.45em;
		font-size: 2.05rem;
		font-weight: 600;
		line-height: 1.45;
		letter-spacing: 0;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 1rem;
		color: var(--muted);
		font-size: 0.78rem;
		font-variant-numeric: tabular-nums;
	}
	.meta .dot {
		color: var(--line-strong);
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.9rem;
		margin-bottom: 2.6rem;
	}
	.tags a {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.04em;
	}
	.tags a:hover {
		color: var(--accent);
		text-decoration: none;
	}
	.pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
		margin-top: 3.5rem;
		padding-top: 1.4rem;
		border-top: 1px solid var(--line);
		font-size: 0.86rem;
	}
	.pager-item {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		min-height: 1px;
	}
	.pager-item.next {
		text-align: right;
	}
	.pager-label {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.06em;
	}
	.pager a {
		font-family: var(--font-serif);
		font-size: 0.95rem;
		line-height: 1.55;
	}
	@media (max-width: 900px) {
		.grid {
			grid-template-columns: minmax(0, 1fr);
			gap: 0;
		}
		/* 小屏上分类目录让位给正文，用面包屑回到分类页 */
		.grid :global(.sidebar) {
			display: none;
		}
		h1 {
			font-size: 1.55rem;
		}
		.pager {
			grid-template-columns: minmax(0, 1fr);
		}
		.pager-item.next {
			text-align: left;
		}
	}
</style>
