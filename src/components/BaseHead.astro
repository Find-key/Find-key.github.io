---
import type { ImageMetadata } from 'astro';
import { SITE } from '../consts';
import { absoluteAssetUrl, withBase } from '../utils/url';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	/** 文章页传 'article'，列表/首页传 'website' */
	type?: 'website' | 'article';
	/** 纯文章标题（用于结构化数据 headline，不含站点后缀） */
	articleTitle?: string;
	pubDate?: Date;
	updatedDate?: Date;
	tags?: string[];
}

const {
	title,
	description,
	image,
	type = 'website',
	articleTitle,
	pubDate,
	updatedDate,
	tags = [],
} = Astro.props;

// 注意：Astro.url.pathname 在配置了 base 之后已经包含 base（如 /blog/posts/x/），
// 所以这里不能再过一遍 withBase()，否则会变成 /blog/blog/...
const canonicalURL = new URL(Astro.url.pathname, SITE.url);
// 文章自带封面就用封面，否则用 public/og.png（站点分享卡）
const ogImage = image ? absoluteAssetUrl(image.src) : absoluteAssetUrl('/og.png');
const modifiedDate = updatedDate ?? pubDate;

const jsonLd =
	type === 'article'
		? {
				'@context': 'https://schema.org',
				'@type': 'BlogPosting',
				headline: articleTitle ?? title,
				description,
				url: canonicalURL.toString(),
				image: ogImage,
				...(pubDate ? { datePublished: pubDate.toISOString() } : {}),
				...(modifiedDate ? { dateModified: modifiedDate.toISOString() } : {}),
				inLanguage: SITE.lang,
				author: {
					'@type': 'Person',
					name: SITE.author,
					url: SITE.url,
				},
				...(tags.length > 0 ? { keywords: tags.join(', ') } : {}),
			}
		: null;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="color-scheme" content="light" />
<meta name="theme-color" content="#fbf9f5" />
<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
<link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32.png')} />
<link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
<link rel="sitemap" href={withBase('/sitemap-index.xml')} />
<link rel="alternate" type="application/rss+xml" title={SITE.title} href={withBase('/rss.xml')} />
<meta name="generator" content={Astro.generator} />
<meta name="author" content={SITE.author} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:locale" content="zh_CN" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
{
	type === 'article' && (
		<>
			{pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
			{modifiedDate && (
				<meta property="article:modified_time" content={modifiedDate.toISOString()} />
			)}
			<meta property="article:author" content={SITE.author} />
			{tags.map((tag) => (
				<meta property="article:tag" content={tag} />
			))}
		</>
	)
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{
	jsonLd && (
		<script
			type="application/ld+json"
			is:inline
			set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
		/>
	)
}
