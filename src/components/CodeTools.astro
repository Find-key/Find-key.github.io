---
/**
 * 文章代码块的交互增强（纯前端，不加依赖）：
 *   - 块顶部一条工具行，右侧「复制」；复制成功短暂显示「已复制」
 *   - 长代码块默认折叠（超过 FOLD_LINES 行），下方给「展开（N 行）／收起」
 *   - 折叠只是视觉上的，DOM 里内容完整，不影响搜索与复制
 *
 * 工具行占真实高度（不是悬浮覆盖），所以不会压住第一行代码。
 */
---

<script>
	const FOLD_LINES = 26;
	const PREVIEW_ROWS = 14;

	function fallbackCopy(text: string): boolean {
		// 非安全上下文（比如用局域网 IP 打开）没有 navigator.clipboard，退回 execCommand
		const ta = document.createElement('textarea');
		ta.value = text;
		ta.setAttribute('readonly', '');
		ta.style.position = 'fixed';
		ta.style.top = '-1000px';
		document.body.appendChild(ta);
		ta.select();
		let ok = false;
		try {
			ok = document.execCommand('copy');
		} catch {
			ok = false;
		}
		ta.remove();
		return ok;
	}

	async function copyText(text: string, btn: HTMLButtonElement) {
		const old = btn.textContent;
		try {
			if (navigator.clipboard?.writeText) {
				await navigator.clipboard.writeText(text);
			} else if (!fallbackCopy(text)) {
				throw new Error('copy failed');
			}
			btn.textContent = '已复制';
		} catch {
			btn.textContent = fallbackCopy(text) ? '已复制' : '复制失败';
		}
		setTimeout(() => {
			btn.textContent = old;
		}, 1400);
	}

	function enhance(pre: HTMLElement) {
		if (pre.closest('.code-block')) return;

		const wrap = document.createElement('div');
		wrap.className = 'code-block';
		pre.parentNode?.insertBefore(wrap, pre);

		const text = pre.innerText.replace(/\n$/, '');
		const lines = text.split('\n').length;

		const head = document.createElement('div');
		head.className = 'code-head';

		const copy = document.createElement('button');
		copy.type = 'button';
		copy.className = 'code-btn';
		copy.textContent = '复制';
		copy.addEventListener('click', () => copyText(text, copy));
		head.appendChild(copy);
		wrap.appendChild(head);

		if (lines > FOLD_LINES) {
			const body = document.createElement('div');
			body.className = 'code-body is-folded';
			body.style.maxHeight = `${PREVIEW_ROWS * 1.5}rem`;
			body.appendChild(pre);
			wrap.appendChild(body);

			const more = document.createElement('button');
			more.type = 'button';
			more.className = 'code-more';
			more.textContent = `展开（共 ${lines} 行）`;
			more.addEventListener('click', () => {
				const folded = body.classList.toggle('is-folded');
				body.style.maxHeight = folded ? `${PREVIEW_ROWS * 1.5}rem` : 'none';
				more.textContent = folded ? `展开（共 ${lines} 行）` : '收起';
			});
			wrap.appendChild(more);
			return;
		}

		wrap.appendChild(pre);
	}

	function run() {
		document.querySelectorAll<HTMLElement>('.prose pre').forEach(enhance);
	}

	run();
	document.addEventListener('astro:page-load', run as EventListener);
</script>

<style is:global>
	.code-block {
		margin: 1.6rem 0;
		background: var(--code-bg);
		border-radius: 4px;
	}
	/* Shiki 会给 <pre> 写内联 background-color，必须用 !important 才盖得住，
	   否则工具行那块背景和代码区背景不是同一个色，看起来按钮"浮在块外面" */
	.prose .code-block pre,
	.code-block pre {
		margin: 0 !important;
		background: transparent !important;
		border: 0 !important;
		border-radius: 0 !important;
		padding-top: 0.15rem;
	}

	/* 工具行：真实占位的一行，右侧放按钮 */
	.code-head {
		display: flex;
		justify-content: flex-end;
		align-items: center;
		padding: 0.32rem 0.6rem 0;
		min-height: 0.9rem;
		opacity: 0;
		transition: opacity 0.15s ease;
	}
	.code-block:hover .code-head,
	.code-head:focus-within {
		opacity: 1;
	}
	@media (hover: none) {
		.code-head {
			opacity: 1;
		}
	}

	.code-body {
		position: relative;
		overflow: hidden;
	}
	/* 折叠时底部一条渐隐，暗示还有内容 */
	.code-body.is-folded::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 3.5rem;
		pointer-events: none;
		background: linear-gradient(to bottom, transparent, var(--code-bg) 80%);
	}

	.code-tools {
		display: flex;
		gap: 0.3rem;
	}

	.code-btn,
	.code-more {
		padding: 0;
		border: none;
		border-radius: 0;
		background: transparent;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.66rem;
		letter-spacing: 0.04em;
		cursor: pointer;
		transition: color 0.15s ease, border-color 0.15s ease;
	}
	.code-btn:hover,
	.code-more:hover {
		color: var(--text);
	}

	.code-more {
		display: block;
		width: 100%;
		margin-top: 0.15rem;
		padding: 0.3rem 0;
		text-align: center;
		background: transparent;
		border: none;
		border-top: 1px dashed var(--line);
		border-radius: 0 0 4px 4px;
	}
	.code-more:hover {
		color: var(--text);
	}
</style>
