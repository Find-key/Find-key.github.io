---
/**
 * 文章代码块的交互增强（纯前端，不加依赖）：
 *   - 块顶部一条工具行，右侧「复制」；复制成功短暂显示「已复制」
 *   - 长代码块默认折叠（超过 FOLD_LINES 行），下方给「展开（N 行）／收起」
 *   - 折叠只是视觉上的，DOM 里内容完整，不影响搜索与复制
 *
 * 工具行占真实高度（不是悬浮覆盖），所以不会压住第一行代码。
 */
---

<script>
	const FOLD_LINES = 26;
	const PREVIEW_ROWS = 14;

	function fallbackCopy(text: string): boolean {
		// 非安全上下文（比如用局域网 IP 打开）没有 navigator.clipboard，退回 execCommand
		const ta = document.createElement('textarea');
		ta.value = text;
		ta.setAttribute('readonly', '');
		ta.style.position = 'fixed';
		ta.style.top = '-1000px';
		document.body.appendChild(ta);
		ta.select();
		let ok = false;
		try {
			ok = document.execCommand('copy');
		} catch {
			ok = false;
		}
		ta.remove();
		return ok;
	}

	async function copyString(text: string): Promise<boolean> {
		try {
			if (navigator.clipboard?.writeText) {
				await navigator.clipboard.writeText(text);
				return true;
			}
			return fallbackCopy(text);
		} catch {
			return fallbackCopy(text);
		}
	}

	async function copyText(text: string, btn: HTMLButtonElement) {
		const old = btn.textContent;
		btn.textContent = (await copyString(text)) ? '已复制' : '复制失败';
		setTimeout(() => {
			btn.textContent = old;
		}, 1400);
	}

	function enhance(pre: HTMLElement) {
		if (pre.closest('.code-block')) return;

		const wrap = document.createElement('div');
		wrap.className = 'code-block';
		pre.parentNode?.insertBefore(wrap, pre);

		const text = (pre.textContent ?? '').replace(/\n$/, '');
		const lines = text.split('\n').length;
		const lang = (pre.dataset.language ?? '').trim();

		const head = document.createElement('div');
		head.className = 'code-head';

		if (lang && lang.toLowerCase() !== 'plaintext') {
			const badge = document.createElement('span');
			badge.className = 'code-lang';
			badge.textContent = lang;
			head.appendChild(badge);
		}

		const copy = document.createElement('button');
		copy.type = 'button';
		copy.className = 'code-btn';
		copy.textContent = '复制';
		copy.addEventListener('click', () => copyText(text, copy));
		head.appendChild(copy);
		wrap.appendChild(head);

		if (lines > FOLD_LINES) {
			const body = document.createElement('div');
			body.className = 'code-body is-folded';
			body.style.maxHeight = `${PREVIEW_ROWS * 1.5}rem`;
			body.appendChild(pre);
			wrap.appendChild(body);

			const more = document.createElement('button');
			more.type = 'button';
			more.className = 'code-more';
			more.textContent = `展开（共 ${lines} 行）`;
			more.addEventListener('click', () => {
				const folded = body.classList.toggle('is-folded');
				body.style.maxHeight = folded ? `${PREVIEW_ROWS * 1.5}rem` : 'none';
				more.textContent = folded ? `展开（共 ${lines} 行）` : '收起';
				if (folded) {
					// 收起时若代码块头部已滚出视口上方，平滑回滚至代码块头部，避免视口剧烈跳跃
					const rect = wrap.getBoundingClientRect();
					if (rect.top < 60) {
						wrap.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
					}
				}
			});
			wrap.appendChild(more);
			return;
		}

		wrap.appendChild(pre);
	}

	function enhanceHeadings() {
		document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id]').forEach((heading) => {
			if (heading.querySelector('.heading-anchor')) return;
			const id = heading.id;
			const anchor = document.createElement('a');
			anchor.className = 'heading-anchor';
			anchor.href = `#${id}`;
			anchor.setAttribute('aria-label', '复制本节链接');
			anchor.textContent = '#';
			anchor.addEventListener('click', async () => {
				const url = `${window.location.origin}${window.location.pathname}#${id}`;
				if (await copyString(url)) {
					anchor.textContent = '✓';
					setTimeout(() => {
						anchor.textContent = '#';
					}, 1200);
				}
			});
			heading.appendChild(anchor);
		});
	}

	function enhanceTables() {
		document.querySelectorAll<HTMLTableElement>('.prose table').forEach((table) => {
			if (table.closest('.table-wrap')) return;
			const wrap = document.createElement('div');
			wrap.className = 'table-wrap';
			table.parentNode?.insertBefore(wrap, table);
			wrap.appendChild(table);
		});
	}

	function run() {
		document.querySelectorAll<HTMLElement>('.prose pre').forEach(enhance);
		enhanceHeadings();
		enhanceTables();
	}

	run();
	document.addEventListener('astro:page-load', run as EventListener);
</script>

<style is:global>
	.code-block {
		margin: 1.6rem 0;
		background: var(--code-bg);
		border-radius: 4px;
	}
	/* Shiki 会给 <pre> 写内联 background-color，必须用 !important 才盖得住，
	   否则工具行那块背景和代码区背景不是同一个色，看起来按钮"浮在块外面" */
	.prose .code-block pre,
	.code-block pre {
		margin: 0 !important;
		background: transparent !important;
		border: 0 !important;
		border-radius: 0 !important;
		padding-top: 0.15rem;
	}

	/* 工具行：真实占位的一行，左侧显示语言，右侧放复制按钮 */
	.code-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.35rem 0.7rem 0.1rem;
		min-height: 1.2rem;
	}
	.code-lang {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.64rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		user-select: none;
	}
	.code-btn {
		margin-left: auto;
		opacity: 0;
		transition: opacity 0.15s ease, color 0.15s ease;
	}
	.code-block:hover .code-btn,
	.code-btn:focus-visible {
		opacity: 1;
	}
	@media (hover: none) {
		.code-btn {
			opacity: 1;
		}
	}

	.heading-anchor {
		margin-left: 0.42em;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.78em;
		font-weight: 400;
		border-bottom: none !important;
		opacity: 0;
		transition: opacity 0.15s ease, color 0.15s ease;
	}
	.prose :is(h2, h3):hover .heading-anchor,
	.heading-anchor:focus-visible {
		opacity: 1;
	}
	.heading-anchor:hover {
		color: var(--accent);
		text-decoration: none;
	}
	@media (hover: none) {
		.heading-anchor {
			opacity: 0.55;
		}
	}

	.table-wrap {
		margin: 1.6em 0;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
	}
	.prose .table-wrap table {
		margin: 0;
	}

	.code-body {
		position: relative;
		overflow: hidden;
	}
	/* 折叠时底部一条渐隐，暗示还有内容 */
	.code-body.is-folded::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 3.5rem;
		pointer-events: none;
		background: linear-gradient(to bottom, transparent, var(--code-bg) 80%);
	}

	.code-btn,
	.code-more {
		padding: 0;
		border: none;
		border-radius: 0;
		background: transparent;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.66rem;
		letter-spacing: 0.04em;
		cursor: pointer;
		transition: color 0.15s ease, border-color 0.15s ease;
	}
	.code-btn:hover,
	.code-more:hover {
		color: var(--text);
	}

	.code-more {
		display: block;
		width: 100%;
		margin-top: 0.15rem;
		padding: 0.3rem 0;
		text-align: center;
		background: transparent;
		border: none;
		border-top: 1px dashed var(--line);
		border-radius: 0 0 4px 4px;
	}
	.code-more:hover {
		color: var(--text);
	}
</style>
