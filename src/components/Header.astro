---
/**
 * 站头：左侧字标 + 右侧链接（归档 / 友链）。
 * 首页的字标同时充当 <h1>，内页的 h1 由页面正文自己提供，避免出现两个 h1。
 */
import { NAV, SITE } from '../consts';
import { withBase } from '../utils/url';

interface Props {
	variant?: 'home' | 'inner';
}

const { variant = 'inner' } = Astro.props;

// 当前所在栏目，用于给导航加下划线
const BASE = import.meta.env.BASE_URL.replace(/\/+$/, '');
const current = (Astro.url.pathname.replace(BASE, '').replace(/\/+$/, '') || '/') as string;
const isActive = (href: string) => current === href || current.startsWith(`${href}/`);
---

<header class="site-header">
	<div class="inner">
		{
			variant === 'home' ? (
				<h1 class="brand">
					<a href={withBase('/')}>{SITE.title}</a>
				</h1>
			) : (
				<a class="brand" href={withBase('/')}>
					{SITE.title}
				</a>
			)
		}

		<nav class="nav">
			{
				NAV.map((item) => (
					<a href={withBase(item.href)} class:list={[{ active: isActive(item.href) }]}>
						{item.label}
					</a>
				))
			}
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		border-bottom: 1px solid var(--line);
		background: rgba(251, 249, 245, 0.9);
		backdrop-filter: saturate(160%) blur(10px);
		-webkit-backdrop-filter: saturate(160%) blur(10px);
	}
	.inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		max-width: var(--page-width);
		height: 58px;
		margin: 0 auto;
		padding: 0 1.25rem;
	}
	/* 字标：首页是 h1，内页是普通链接；两种都用同一套排版和颜色。
	   注意：内页的 <a> 本身就是 .brand，所以颜色必须写在 .brand 上，
	   只写 .brand a 的话它会继承全站链接的墨绿色。 */
	.brand,
	h1.brand {
		margin: 0;
		color: var(--text);
		font-family: var(--font-serif);
		font-size: 1.02rem;
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: -0.005em;
		white-space: nowrap;
	}
	.brand a,
	h1.brand a {
		color: inherit;
	}
	.brand:hover,
	.brand a:hover {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-decoration-color: var(--line-strong);
		text-underline-offset: 0.22em;
	}
	.nav {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}
	.nav a {
		color: var(--muted);
		font-size: 0.86rem;
		transition: color 0.15s ease;
	}
	.nav a:hover {
		color: var(--text);
		text-decoration: none;
	}
	.nav a.active {
		color: var(--text);
	}
	/* 当前栏目：文字下方 1px 短下划线，不用色块 */
	.nav a.active::after {
		display: block;
		height: 1px;
		margin-top: 3px;
		background: var(--accent);
		content: '';
	}
	@media (max-width: 520px) {
		.nav {
			gap: 1.1rem;
		}
		.nav a {
			font-size: 0.82rem;
		}
		.brand,
		h1.brand {
			font-size: 0.96rem;
		}
	}
</style>
