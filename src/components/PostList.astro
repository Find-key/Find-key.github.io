---
import type { Post } from '../utils/posts';
import { postUrl } from '../utils/url';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: Post[];
	showDate?: boolean;
}

const { posts, showDate = true } = Astro.props;
---

<ul class="posts">
	{
		posts.map((post) => (
			<li>
				<a class="row" href={postUrl(post.id)}>
					<span class="line">
						<span class="title">{post.data.title}</span>
						{showDate && (
							<span class="date">
								<FormattedDate date={post.data.pubDate} format="short" />
							</span>
						)}
					</span>
					<span class="desc">{post.data.description}</span>
				</a>
			</li>
		))
	}
	{posts.length === 0 && <li class="empty">还没有文章。</li>}
</ul>

<style>
	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li + li {
		border-top: 1px solid var(--line);
	}
	.row {
		display: block;
		padding: 1.05rem 0;
	}
	.row:hover {
		text-decoration: none;
	}
	.line {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.25rem;
	}
	.title {
		font-family: var(--font-serif);
		color: var(--text);
		font-size: 1.07rem;
		font-weight: 600;
		line-height: 1.55;
		letter-spacing: 0;
	}
	.title::after {
		margin-left: 0.4em;
		color: var(--accent);
		content: '→';
		opacity: 0;
		transition: opacity 0.15s ease;
	}
	.row:hover .title {
		color: var(--accent);
	}
	.row:hover .title::after {
		opacity: 1;
	}
	.date {
		flex: none;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.02em;
		white-space: nowrap;
	}
	.desc {
		display: block;
		margin-top: 0.2rem;
		color: var(--muted);
		font-size: 0.85rem;
		line-height: 1.7;
		text-wrap: pretty;
	}
	.empty {
		color: var(--muted);
		padding: 1rem 0;
	}
</style>
