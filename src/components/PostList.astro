---
import type { Post } from '../utils/posts';
import { postUrl } from '../utils/url';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: Post[];
	showDate?: boolean;
}

const { posts, showDate = true } = Astro.props;
---

<ul class="posts">
	{
		posts.map((post) => (
			<li>
				<a class="row" href={postUrl(post.id)}>
					<span class="line">
						<span class="title">{post.data.title}</span>
						{showDate && (
							<span class="date">
								<FormattedDate date={post.data.pubDate} format="short" />
							</span>
						)}
					</span>
					<span class="desc">{post.data.description}</span>
				</a>
			</li>
		))
	}
	{posts.length === 0 && <li class="empty">还没有文章。</li>}
</ul>

<style>
	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li + li {
		border-top: 1px solid var(--line);
	}
	.row {
		display: block;
		padding: 1rem 0;
	}
	.row:hover {
		text-decoration: none;
	}
	.line {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}
	.title {
		color: var(--text);
		font-size: 1rem;
		font-weight: 500;
		line-height: 1.65;
	}
	.row:hover .title {
		color: var(--accent);
	}
	.date {
		flex: none;
		color: var(--muted);
		font-size: 0.76rem;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.desc {
		display: block;
		margin-top: 0.15rem;
		color: var(--muted);
		font-size: 0.84rem;
		line-height: 1.65;
	}
	.empty {
		color: var(--muted);
		padding: 1rem 0;
	}
</style>
