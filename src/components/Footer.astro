---
import { SITE } from '../consts';
import { withBase } from '../utils/url';

const today = new Date();
---

<footer class="site-footer">
	<div class="inner">
		<p class="copy">© {today.getFullYear()} {SITE.author}</p>
		<nav class="links">
			<a href={withBase('/posts')}>全部文章</a>
			<a href={withBase('/categories')}>分类</a>
			<a href={withBase('/tags')}>标签</a>
			{SITE.github && <a href={SITE.github} target="_blank" rel="noopener">GitHub</a>}
			{SITE.email && <a href={`mailto:${SITE.email}`}>邮箱</a>}
			<a href={withBase('/rss.xml')}>RSS</a>
		</nav>
	</div>
</footer>

<style>
	/* 页脚是纯白卡片，只用一条上边框分隔。
	   上一版用了渐变背景 + 页面背景渐变叠在一起，才会出现那条"半隐藏的栏"。 */
	.site-footer {
		margin-top: 5rem;
		border-top: 1px solid var(--line);
		background: var(--bg);
	}
	.inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		max-width: var(--page-width);
		margin: 0 auto;
		padding: 1.5rem 1.25rem 2.5rem;
		color: var(--muted);
		font-size: 0.8rem;
	}
	.copy {
		margin: 0;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.1rem;
	}
	.links a {
		color: var(--muted);
	}
	.links a:hover {
		color: var(--text);
		text-decoration: none;
	}
</style>
