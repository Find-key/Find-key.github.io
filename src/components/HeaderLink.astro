---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href = '/', class: className, ...props } = Astro.props;

// 站点可能部署在子路径（base = /blog/），比较前要先把 base 和尾部斜杠都抹平，
// 否则 '/blog/posts' 和 '/blog/posts/' 永远不相等，导航高亮会失效。
const BASE = import.meta.env.BASE_URL.replace(/\/+$/, '');

function normalize(path: string): string {
	let p = path.replace(/\/+$/, '') || '/';
	if (BASE && (p === BASE || p.startsWith(`${BASE}/`))) {
		p = p.slice(BASE.length) || '/';
	}
	return p;
}

const pathname = normalize(Astro.url.pathname);
const target = normalize(href);

const isActive =
	target === '/' ? pathname === '/' : pathname === target || pathname.startsWith(`${target}/`);
---

<a href={href} class:list={['nav-link', className, { active: isActive }]} {...props}>
	<slot />
</a>

<style>
	.nav-link {
		position: relative;
		display: inline-block;
		color: var(--muted);
		font-size: 0.85rem;
		line-height: var(--header-height);
	}
	.nav-link:hover {
		color: var(--text);
		text-decoration: none;
	}
	.nav-link.active {
		color: var(--text);
	}
	/* 贴住页头下边框的 2px 强调条，比下划线干净 */
	.nav-link.active::after {
		position: absolute;
		right: -2px;
		bottom: 0;
		left: -2px;
		height: 2px;
		background: var(--accent);
		content: '';
	}
</style>
